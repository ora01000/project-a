LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=not-needed
LLM_MODEL=./llm_model/qwen3-4b-4bit-mlx
# LLM_MAX_CONTEXT_TOKENS=32768
#
# 목업 환경 OpenAI LLM (환경설정 > 관리자 작업 > (목업)LLM 변경)
# MOCK_OPENAI_API_KEY=
# OPENAI_API_KEY=
# MOCK_OPENAI_MODEL=gpt-4o-mini

# Database (PostgreSQL required on this branch)
# DATABASE_URL=postgresql://axit:CHANGE_ME@localhost:30222/axit
# MY_NOTES_CONTENT_BACKEND=database
# USER_COMM_LOG_BACKEND=file
# BACKEND_ROLE=all

# Backend health check interval in seconds (LLM, MCP, agents)
# HEALTH_CHECK_INTERVAL_SECONDS=30

# Backend service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
# OKD/Kubernetes: Service name "backend" injects BACKEND_PORT=tcp://<cluster-ip>:8080.
# Use BACKEND_LISTEN_PORT to set the uvicorn bind port explicitly, or rely on auto-parsing.
# BACKEND_LISTEN_PORT=8080

# Agent runtime separation — all agent execution is delegated to an external sandbox.
# mock: local dev stub (no sandbox required) — default
# http: connect to external AXIT platform APIs (server/OKD deployment)
AGENT_RUNTIME_MODE=mock
# AGENT_RUNTIME_MODE=http
# AGENT_RUNTIME_HTTP_TIMEOUT_SECONDS=3600
# CONTROL_PLANE_BASE_URL=http://localhost:8080
# AGENT_RUNTIME_API_KEY=
#
# AGENT_RUNTIME_MODE=http 시 AXIT 플랫폼 연동 (type=1 agentruntime 레코드 사용)
# TOKEN_URL=https://test.nudp.lguplus.co.kr/portal/auths/v1/token
# AGENT_URL=https://test.nudp.lguplus.co.kr/aihub/agents/v1
# ORCHESTRATOR_URL=https://test.nudp.lguplus.co.kr/aihub/orchestrators/v1
#
# AGENT_RUNTIME_MODE=mock 시 로컬 목업 (기본값, CONTROL_PLANE_BASE_URL 기반)
# TOKEN_URL=http://127.0.0.1:8080/portal/auths/v1/token
# AGENT_URL=http://127.0.0.1:8080/aihub/agents/v1
# ORCHESTRATOR_URL=http://127.0.0.1:8080/aihub/orchestrators/v1
#
# 공통 (미설정 시 mock/http 각각 기본값 사용)
# CLIENT_ID=
# CLIENT_SECRET=
# SERVICE_ID=prvops
#
# 별칭 (TOKEN_URL/AGENT_URL/CLIENT_ID/CLIENT_SECRET/SERVICE_ID 와 동일)
# AXIT_TOKEN_URL=https://example.com/portal/auths/v1/token
# AXIT_AGENT_URL=https://example.com/aihub/agents/v1
# AXIT_ORCHESTRATOR_URL=https://example.com/aihub/orchestrators/v1
# AXIT_SERVICE_ID=prvops

# Display timezone (server default: Asia/Seoul)
# TZ=Asia/Seoul

# Frontend service
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=9001
# OKD/Kubernetes: Service name "frontend" injects FRONTEND_PORT=tcp://<cluster-ip>:9001.
# Use FRONTEND_LISTEN_PORT to set the nginx listen port explicitly, or rely on auto-parsing.
# FRONTEND_LISTEN_PORT=9001

# Frontend -> Backend API (Vite dev proxy / nginx container)
BACKEND_API_HOST=localhost
BACKEND_API_PORT=8080
# OKD/Kubernetes: matching Service names may inject tcp://... values.
# BACKEND_API_LISTEN_PORT=8080

# MCP server endpoints (override config/mcp_servers.yaml)
# Server key는 mcp_servers.yaml의 키와 동일 (대문자 + 언더스코어)
#
# Agent -> MCP mapping:
#   dprv6-k8s, pcicd-k8s, dprv-k8s, dprsv-k8s, dprmn-k8s, dprrt-k8s, dpvs-k8s, dtest-k8s
#     -> kubernetes, kubectl_ai
#   kubevirt -> kubernetes
#   vcenter  -> vcenter
#   ansible  -> ansible
#
# MCP_KUBERNETES_URL=http://k8smcp.ora01000.pe.kr:32716/mcp
# MCP_KUBERNETES_ENABLED=true
# MCP_KUBECTL_AI_URL=http://kubectl-ai.ora01000.pe.kr:32716/mcp
# MCP_KUBECTL_AI_ENABLED=true
# MCP_VCENTER_URL=http://vmware-aiops.ora01000.pe.kr:32716/mcp
# MCP_VCENTER_ENABLED=true
# MCP_ANSIBLE_URL=http://localhost:9091/mcp
# MCP_ANSIBLE_ENABLED=false

# Job notification - Email SMTP is configured in Admin UI (mailserver_config DB table).

# Job notification - MS Teams
# TEAMS_ENABLED=true
# TEAMS_MODE=webhook
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
#
# Graph API mode (TEAMS_MODE=graph)
# TEAMS_TENANT_ID=
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=
# TEAMS_TEAM_ID=
# TEAMS_CHANNEL_ID=
# TEAMS_TIMEOUT_SECONDS=30

# Whatap event webhook (optional secret for X-Whatap-Secret header)
# WHATAP_WEBHOOK_SECRET=

# INFRA_GAP_ANALYSIS / JOB_DECISION http-mode LLM gateway API key
# PRIVATE_LLM_API_KEY=

# Integrated chat user communication logs
# USER_COMM_LOG=data/user_comm_logs
# USER_COMM_RETENTION=30

# Job requester daemon (disabled; use Settings > 테스트 작업 발송 instead)
# JOB_REQUESTER_ENABLED=false
# JOB_REQUESTER_INTERVAL_MINUTES=60
# JOB_REQUESTER_INITIAL_DELAY_SECONDS=60

# Approved job processor daemon (delegates status_code=2 jobs to helpdesk)
# JOB_PROCESSOR_ENABLED=true
# JOB_PROCESSOR_POLL_INTERVAL_SECONDS=60
# JOB_PROCESSOR_INITIAL_DELAY_SECONDS=0
# AGENT_RUNTIME_MODE=http 시 agentruntime 에 helpdesk 오케스트레이터가 없으면 작업을 건너뜀
# JOB_PROCESSOR_HELPDESK_LOCAL_AGENT_ID=helpdesk
# JOB_PROCESSOR_HELPDESK_AXIT_AGENT_ID=

# Job review tab AI auditor (orchestrator invoke before human approval)
# JOB_AUDITOR_LOCAL_AGENT_ID=JOB_AUDITOR_AGENT
# JOB_AUDITOR_AXIT_AGENT_ID=

# My notes: Redis edit buffer flushed to filesystem periodically
# MY_NOTES_FLUSH_ENABLED=true
# MY_NOTES_FLUSH_INTERVAL_SECONDS=300
# MY_NOTES_FLUSH_INITIAL_DELAY_SECONDS=0

# Workflow work_node file uploads: {UPLOAD_HOME}/{userid}/{work_node.uuid}/...
# Container default: /app/upload. Local: UPLOAD_HOME=./upload (or absolute path).
# UPLOAD_HOME=/app/upload

# K8S 인프라 scrape
# http 모드: ConfigMap 마운트 경로 필수 (/etc/k8s/kubeconfig)
# mock/local: 파일 없으면 로컬 KUBECONFIG/~/.kube/config 사용
# K8S_COLLECTOR_KUBECONFIG=/etc/k8s/kubeconfig
# K8S_COLLECTOR_FALLBACK_CURRENT_CONTEXT=true
# K8S_COLLECTOR_SCHEDULE_ENABLED=true
# K8S_COLLECTOR_SCHEDULE_POLL_INTERVAL_SECONDS=30
# K8S_COLLECTOR_SCHEDULE_INITIAL_DELAY_SECONDS=5

# Auth provider: db (default, local users table) | madang (madang IDP)
# AUTH_PROVIDER_TYPE=db
# AUTH_PROVIDER_TYPE=madang

# madang 직접 연동 (server-samples/oauth/login.jsp Python 포팅, ENVS 참고)
# OAUTH_URL=https://172.21.70.74/uplus/intuser/oauth2/token
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_GRANT_TYPE=password
# OAUTH_SCOPE=EA
# OAUTH_AUTH_TYPE=IM
# OAUTH_VERIFY_SSL=false

# 또는 기존 oauth 프록시(WAR) 경유 — OAUTH_URL 미설정 시 사용
# OAUTH_PROXY=http://oauth.lguplus-securities.svc.cluster.local:8080

# Redis (session store — not packaged in deployment; run as separate process)
# REDIS_URL=redis://localhost:6379/0

# Bearer session (B-2): sliding TTL + absolute max lifetime
# AUTH_SESSION_TTL_SECONDS=3600
# AUTH_SESSION_ABSOLUTE_MAX_SECONDS=28800
