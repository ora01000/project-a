{
  "work_node": [
    {
      "work_name": "만료 SSL 인증서 추출",
      "work_description": "dprv-k8s 클러스터의 ingress 또는 route에서 SSL 인증서 정보를 조회하여 파일로 저장한다.",
      "uuid": "a1111111-1111-4{BANK_ACCOUNT_NUMBER}1111",
      "target_agent": "5e8d670a-e958-4db6-97c2-3040f11b7529",
      "work_script": "# dprv-k8s 클러스터의 ingress/route에서 TLS 인증서를 추출하여 파일로 저장\nmkdir -p /app/upload/a1111111-1111-4{BANK_ACCOUNT_NUMBER}1111\nfor ns in $(kubectl get ns -o jsonpath='{.items[*].metadata.name}'); do\n  for ing in $(kubectl get ingress -n $ns -o jsonpath='{.items[*].metadata.name}' 2>/dev/null); do\n    secret=$(kubectl get ingress $ing -n $ns -o jsonpath='{.spec.tls[0].secretName}' 2>/dev/null)\n    [ -n \"$secret\" ] && kubectl get secret $secret -n $ns -o jsonpath='{.data.tls\\.crt}' 2>/dev/null | base64 -d > /app/upload/a1111111-1111-4{BANK_ACCOUNT_NUMBER}1111/${ns}_${ing}_ingress.crt\n  done\n  for rt in $(oc get route -n $ns -o jsonpath='{.items[*].metadata.name}' 2>/dev/null); do\n    oc get route $rt -n $ns -o jsonpath='{.spec.tls.certificate}' 2>/dev/null > /app/upload/a1111111-1111-4{BANK_ACCOUNT_NUMBER}1111/${ns}_${rt}_route.crt\n  done\ndone",
      "script_type": "cli"
    },
    {
      "work_name": "인증서 파일 존재 확인",
      "work_description": "추출된 인증서 파일이 없는 경우 워크플로우를 종료한다.",
      "uuid": "a2222222-2222-4{BANK_ACCOUNT_NUMBER}2222",
      "target_agent": "5e8d670a-e958-4db6-97c2-3040f11b7529",
      "work_script": "# 인증서 파일 존재 여부 확인, 없으면 실패 처리\nCERT_DIR=/app/upload/a1111111-1111-4{BANK_ACCOUNT_NUMBER}1111\nif [ -z \"$(ls -A $CERT_DIR 2>/dev/null)\" ]; then\n  echo 'No certificate files found. Exiting.'\n  exit 1\nfi",
      "script_type": "cli"
    },
    {
      "work_name": "인증서 만료일자 확인 및 보고서 작성",
      "work_description": "추출한 인증서 파일의 만료일자를 확인하고 갱신이 필요한 서비스를 요약한 보고서를 생성한다.",
      "uuid": "a3333333-3333-4{BANK_ACCOUNT_NUMBER}3333",
      "target_agent": "5e8d670a-e958-4db6-97c2-3040f11b7529",
      "work_script": "# 인증서 만료일자 확인 후 보고서 생성\nCERT_DIR=/app/upload/a1111111-1111-4{BANK_ACCOUNT_NUMBER}1111\nREPORT_DIR=/app/upload/a3333333-3333-4{BANK_ACCOUNT_NUMBER}3333\nmkdir -p $REPORT_DIR\necho \"SSL 인증서 만료일자 보고서 - $(date)\" > $REPORT_DIR/report.txt\nfor f in $CERT_DIR/*; do\n  name=$(basename $f)\n  exp=$(openssl x509 -enddate -noout -in $f | cut -d= -f2)\n  echo \"$name : 만료일 $exp\" >> $REPORT_DIR/report.txt\ndone",
      "script_type": "cli"
    }
  ],
  "workflow": {
    "uuid": "a9999999-9999-4{BANK_ACCOUNT_NUMBER}9999",
    "workflow_name": "만료 SSL 인증서 추출 및 보고",
    "workflow_description": "dprv-k8s 클러스터의 ingress/route에서 SSL 인증서를 추출하고 만료일자를 확인하여 보고서를 생성한다. 인증서 파일이 없으면 워크플로우를 종료한다.",
    "workflow": "S->a1111111-1111-4{BANK_ACCOUNT_NUMBER}1111->a2222222-2222-4{BANK_ACCOUNT_NUMBER}2222:E->a3333333-3333-4{BANK_ACCOUNT_NUMBER}3333->E"
  }
}

{
  "work_node": [
    {
      "work_name": "SSL 인증서 추출",
      "work_description": "dprv-k8s 클러스터의 ingress/route에서 사용 중인 SSL 인증서를 조회하여 파일로 저장",
      "work_id": "ssl_extract",
      "target_agent": "5e8d670a-e958-4db6-97c2-3040f11b7529",
      "work_script": "# dprv-k8s ingress/route에서 SSL 인증서(secret) 조회 후 파일 저장\nmkdir -p /app/upload/ssl_extract\nfor ns in $(kubectl get ns -o jsonpath='{.items[*].metadata.name}'); do\n  for ing in $(kubectl get ingress -n $ns -o jsonpath='{.items[*].metadata.name}' 2>/dev/null); do\n    secret=$(kubectl get ingress $ing -n $ns -o jsonpath='{.spec.tls[0].secretName}')\n    [ -n \"$secret\" ] && kubectl get secret $secret -n $ns -o jsonpath='{.data[\"tls.crt\"]}' | base64 -d > /app/upload/ssl_extract/${ns}_${ing}.crt\n  done\n  for rt in $(kubectl get route -n $ns -o jsonpath='{.items[*].metadata.name}' 2>/dev/null); do\n    kubectl get route $rt -n $ns -o jsonpath='{.spec.tls.certificate}' > /app/upload/ssl_extract/${ns}_${rt}_route.crt\n  done\ndone",
      "script_type": "cli"
    },
    {
      "work_name": "인증서 파일 존재 확인",
      "work_description": "추출된 인증서 파일이 없는 경우 워크플로우 종료 처리",
      "work_id": "cert_check",
      "target_agent": "5e8d670a-e958-4db6-97c2-3040f11b7529",
      "work_script": "# 추출된 인증서 파일 존재 여부 확인, 없으면 실패 처리\nif [ -z \"$(ls -A /app/upload/ssl_extract 2>/dev/null)\" ]; then\n  echo 'No certificate files found' >&2\n  exit 1\nfi",
      "script_type": "cli"
    },
    {
      "work_name": "인증서 만료 보고서 생성",
      "work_description": "추출된 인증서 파일의 만료일자를 확인하고 요약 보고서를 생성",
      "work_id": "cert_report",
      "target_agent": "5e8d670a-e958-4db6-97c2-3040f11b7529",
      "work_script": "# 인증서 만료일 확인 및 요약 보고서 생성\nmkdir -p /app/upload/cert_report\nreport=/app/upload/cert_report/ssl_expiry_report.txt\necho \"Service,ExpiryDate\" > $report\nfor f in /app/upload/ssl_extract/*.crt; do\n  name=$(basename $f)\n  end=$(openssl x509 -enddate -noout -in $f | cut -d= -f2)\n  echo \"$name,$end\" >> $report\ndone",
      "script_type": "cli"
    }
  ],
  "workflow": {
    "workflow_name": "만료 SSL 인증서 추출 및 보고",
    "workflow_description": "dprv-k8s 클러스터의 ingress/route에서 SSL 인증서를 추출하고, 파일 존재 여부를 확인한 뒤 만료일자를 요약한 보고서를 생성하는 워크플로우",
    "workflow": "S->ssl_extract->cert_check:E->cert_report->E"
  }
}


